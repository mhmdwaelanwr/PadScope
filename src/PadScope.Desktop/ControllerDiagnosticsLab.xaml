<UserControl x:Class="PadScope.Desktop.ControllerDiagnosticsLab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="680"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Top"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             FontFamily="{DynamicResource PadScopeBodyFont}">
    <UserControl.Resources>
        <Style x:Key="LabCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource B_Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource B_Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="LabSubCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource B_CardAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource B_Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Padding" Value="11" />
        </Style>
        <Style x:Key="LabTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource B_Text}" />
            <Setter Property="FontFamily" Value="{DynamicResource PadScopeDisplayFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="LabLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource B_TextDim}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="Metric" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource B_Text}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="4,8,4,18">
        <Border Style="{StaticResource LabCard}" Padding="18,14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Controller Diagnostics Lab" Style="{StaticResource LabTitle}" FontSize="19" />
                    <TextBlock Text="Read-only native HID diagnostics: drift, range, report cadence and touchpad telemetry."
                               Style="{StaticResource LabLabel}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource B_PrimarySoft}" BorderBrush="{DynamicResource B_Border}"
                            BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,0,8,0">
                        <TextBlock x:Name="ConnectionPillText" Text="Start live input"
                                   Foreground="{DynamicResource B_TextDim}" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <Button Content="Export report" Style="{DynamicResource Sec}" MinWidth="104" Height="34"
                            Click="ExportReportButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource LabCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Stick Drift &amp; Range Lab" Style="{StaticResource LabTitle}" Foreground="{DynamicResource B_Success}" />
                            <TextBlock Text="3-second hands-off center test plus full-rotation range/circularity capture."
                                       Style="{StaticResource LabLabel}" Margin="0,3,0,0" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                            <Button x:Name="StaticTestButton" Content="Run 3s drift test" Height="34" MinWidth="118"
                                    Click="StaticTestButton_Click" />
                            <Button x:Name="RangeCaptureButton" Content="Start range capture" Style="{DynamicResource Sec}"
                                    Height="34" MinWidth="124" Margin="6,0,0,0" Click="RangeCaptureButton_Click" />
                            <Button Content="Reset" Style="{DynamicResource Sec}" Height="34" MinWidth="68"
                                    Margin="6,0,0,0" Click="ResetStickDiagnosticsButton_Click" />
                        </WrapPanel>
                    </Grid>

                    <TextBlock x:Name="DriftInstructionText"
                               Text="Leave both sticks untouched for the static test, then rotate each stick slowly around its full outer edge."
                               Style="{StaticResource LabLabel}" Margin="0,10,0,8" TextWrapping="Wrap" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource LabSubCard}">
                            <StackPanel>
                                <TextBlock Text="LEFT STICK" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="11" />
                                <Canvas x:Name="LeftRangeCanvas" Width="230" Height="230" HorizontalAlignment="Center" Margin="0,6,0,4" />
                                <UniformGrid Columns="2" Margin="0,4,0,0">
                                    <StackPanel><TextBlock Text="DRIFT" Style="{StaticResource LabLabel}" /><TextBlock x:Name="LeftDriftText" Text="--" Style="{StaticResource Metric}" FontSize="16" /></StackPanel>
                                    <StackPanel><TextBlock Text="DEADZONE" Style="{StaticResource LabLabel}" /><TextBlock x:Name="LeftDeadzoneText" Text="--" Style="{StaticResource Metric}" FontSize="16" /></StackPanel>
                                    <StackPanel Margin="0,8,0,0"><TextBlock Text="RANGE COVERAGE" Style="{StaticResource LabLabel}" /><TextBlock x:Name="LeftCoverageText" Text="--" Foreground="{DynamicResource B_Success}" FontWeight="SemiBold" FontSize="13" /></StackPanel>
                                    <StackPanel Margin="0,8,0,0"><TextBlock Text="CIRCULARITY ERROR" Style="{StaticResource LabLabel}" /><TextBlock x:Name="LeftCircularityText" Text="--" Foreground="{DynamicResource B_Text}" FontWeight="SemiBold" FontSize="13" /></StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource LabSubCard}">
                            <StackPanel>
                                <TextBlock Text="RIGHT STICK" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="11" />
                                <Canvas x:Name="RightRangeCanvas" Width="230" Height="230" HorizontalAlignment="Center" Margin="0,6,0,4" />
                                <UniformGrid Columns="2" Margin="0,4,0,0">
                                    <StackPanel><TextBlock Text="DRIFT" Style="{StaticResource LabLabel}" /><TextBlock x:Name="RightDriftText" Text="--" Style="{StaticResource Metric}" FontSize="16" /></StackPanel>
                                    <StackPanel><TextBlock Text="DEADZONE" Style="{StaticResource LabLabel}" /><TextBlock x:Name="RightDeadzoneText" Text="--" Style="{StaticResource Metric}" FontSize="16" /></StackPanel>
                                    <StackPanel Margin="0,8,0,0"><TextBlock Text="RANGE COVERAGE" Style="{StaticResource LabLabel}" /><TextBlock x:Name="RightCoverageText" Text="--" Foreground="{DynamicResource B_Success}" FontWeight="SemiBold" FontSize="13" /></StackPanel>
                                    <StackPanel Margin="0,8,0,0"><TextBlock Text="CIRCULARITY ERROR" Style="{StaticResource LabLabel}" /><TextBlock x:Name="RightCircularityText" Text="--" Foreground="{DynamicResource B_Text}" FontWeight="SemiBold" FontSize="13" /></StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource LabCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Polling Rate Test" Style="{StaticResource LabTitle}" Foreground="#22D3EE" />
                            <TextBlock Text="Native HID report cadence snapshot history" Style="{StaticResource LabLabel}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button x:Name="PollingTestButton" Grid.Column="1" Content="Start test" Height="34" MinWidth="88" Click="PollingTestButton_Click" />
                    </Grid>
                    <Grid Margin="0,14,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="CURRENT" Style="{StaticResource LabLabel}" /><TextBlock x:Name="PollingCurrentText" Text="-- Hz" Style="{StaticResource Metric}" FontSize="31" /></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="PEAK / AVG" Style="{StaticResource LabLabel}" /><TextBlock x:Name="PollingPeakAverageText" Text="-- / -- Hz" Style="{StaticResource Metric}" FontSize="18" /></StackPanel>
                    </Grid>
                    <Canvas x:Name="PollingGraphCanvas" Height="190" MinWidth="300" Margin="0,4,0,10" SizeChanged="PollingGraphCanvas_SizeChanged" />
                    <UniformGrid Columns="2">
                        <Border Style="{StaticResource LabSubCard}" Margin="0,0,6,6"><StackPanel><TextBlock Text="AVG INTERVAL" Style="{StaticResource LabLabel}" /><TextBlock x:Name="PollingIntervalText" Text="-- ms" FontWeight="SemiBold" FontSize="14" /></StackPanel></Border>
                        <Border Style="{StaticResource LabSubCard}" Margin="6,0,0,6"><StackPanel><TextBlock Text="JITTER" Style="{StaticResource LabLabel}" /><TextBlock x:Name="PollingJitterText" Text="-- ms" FontWeight="SemiBold" FontSize="14" /></StackPanel></Border>
                        <Border Style="{StaticResource LabSubCard}" Margin="0,6,6,0"><StackPanel><TextBlock Text="P95 INTERVAL" Style="{StaticResource LabLabel}" /><TextBlock x:Name="PollingP95Text" Text="-- ms" FontWeight="SemiBold" FontSize="14" /></StackPanel></Border>
                        <Border Style="{StaticResource LabSubCard}" Margin="6,6,0,0"><StackPanel><TextBlock Text="SPIKES" Style="{StaticResource LabLabel}" /><TextBlock x:Name="PollingSpikesText" Text="--" FontWeight="SemiBold" FontSize="14" /></StackPanel></Border>
                    </UniformGrid>
                    <TextBlock Text="This measures report cadence, not end-to-end button latency. A very stable controller may produce an almost flat graph."
                               Style="{StaticResource LabLabel}" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="0" Grid.Row="2" Style="{StaticResource LabCard}">
                <StackPanel>
                    <TextBlock Text="Touchpad &amp; Input Health" Style="{StaticResource LabTitle}" Foreground="#60A5FA" />
                    <TextBlock Text="Press detection, contact position and current input state." Style="{StaticResource LabLabel}" Margin="0,3,0,0" />
                    <Border Style="{StaticResource LabSubCard}" Margin="0,14,0,10" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="110" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock x:Name="TouchpadStateText" Text="Touchpad idle" HorizontalAlignment="Center" FontWeight="SemiBold" />
                            <Border Grid.Row="1" Margin="16,10" CornerRadius="12" Background="{DynamicResource B_Background}" BorderBrush="{DynamicResource B_Border}" BorderThickness="1">
                                <Canvas x:Name="TouchpadCanvas"><Ellipse x:Name="TouchPointDot" Width="12" Height="12" Fill="{DynamicResource B_Primary}" Visibility="Collapsed" /></Canvas>
                            </Border>
                            <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                                <TextBlock Text="TOTAL PRESS COUNT" Style="{StaticResource LabLabel}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="TouchpadPressCountText" Text="0" Style="{StaticResource Metric}" FontSize="30" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Button Content="Reset touch count" Style="{DynamicResource Sec}" Height="34" MinWidth="112" HorizontalAlignment="Left" Click="ResetTouchCountButton_Click" />
                    <TextBlock x:Name="InputHealthText" Text="Waiting for live HID data..." Style="{StaticResource LabLabel}" TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Grid.Row="2" Style="{StaticResource LabCard}">
                <StackPanel>
                    <TextBlock Text="Output Tools Recovery" Style="{StaticResource LabTitle}" Foreground="{DynamicResource B_Warning}" />
                    <TextBlock Text="Vibration and lightbar UI are preserved in Advanced HID tools while their hardware-write path is being reintroduced behind a dedicated, non-blocking adapter."
                               Style="{StaticResource LabLabel}" TextWrapping="Wrap" Margin="0,4,0,12" />
                    <Border Style="{StaticResource LabSubCard}">
                        <StackPanel>
                            <TextBlock Text="Why this is isolated" Foreground="{DynamicResource B_Text}" FontWeight="SemiBold" />
                            <TextBlock Text="Your controller accepted native HID input but timed out on DS4 output reports. Keeping diagnostics read-only here prevents one unsupported output path from freezing the whole application."
                                       Style="{StaticResource LabLabel}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
