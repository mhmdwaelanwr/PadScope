<Window x:Class="PadScope.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PadScope" Height="860" Width="1320" MinHeight="700" MinWidth="1080"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <LinearGradientBrush x:Key="GradientPrimary" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0369A1" Offset="0" />
            <GradientStop Color="#38BDF8" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GradientHeader" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0F172A" Offset="0" />
            <GradientStop Color="#1E293B" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="BrushGlow" Color="#38BDF8" Opacity="0.15" />
    </Window.Resources>
    <Grid Background="{StaticResource BrushBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource GradientHeader}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="28,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="54" Height="54" CornerRadius="16" Background="{StaticResource GradientPrimary}">
                    <TextBlock Text="P" FontSize="28" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="PadScope" FontSize="32" FontWeight="Black" Foreground="White" />
                        <Border Background="{StaticResource BrushPrimaryDark}" BorderBrush="{StaticResource BrushPrimary}" BorderThickness="1" CornerRadius="12" Margin="14,4,0,0" Padding="10,3" VerticalAlignment="Center">
                            <TextBlock Text="v1.0" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Gamepad diagnostics toolkit" Style="{StaticResource MutedText}" FontSize="14" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource BrushSurfaceAlt}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="12,6" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource BrushSuccess}" Margin="0,0,8,0" />
                            <TextBlock x:Name="StatusText" Text="Ready" Style="{StaticResource MutedText}" FontSize="12.5" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="ThemeButton" Content="Light" Width="80" Height="34" Style="{StaticResource SecondaryButton}" Click="ToggleThemeButton_Click" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Stats Row -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="28,16,28,16">
            <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="14" Padding="18,14" Margin="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="DEVICES" Style="{StaticResource MutedText}" FontSize="11" FontWeight="Bold" />
                        <TextBlock x:Name="DeviceCountText" Text="0" FontSize="28" FontWeight="Black" Foreground="{StaticResource BrushPrimary}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="12" Background="{StaticResource BrushSurfaceAlt}" VerticalAlignment="Center">
                        <TextBlock Text="&#x1F3AE;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="14" Padding="18,14" Margin="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="PROFILES" Style="{StaticResource MutedText}" FontSize="11" FontWeight="Bold" />
                        <TextBlock x:Name="ProfileCountText" Text="0" FontSize="28" FontWeight="Black" Foreground="{StaticResource BrushSuccess}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="12" Background="{StaticResource BrushSurfaceAlt}" VerticalAlignment="Center">
                        <TextBlock Text="&#x1F9E9;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="14" Padding="18,14" Margin="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="STAGE" Style="{StaticResource MutedText}" FontSize="11" FontWeight="Bold" />
                        <TextBlock x:Name="CurrentStageText" Text="0 / 17" FontSize="28" FontWeight="Black" Foreground="{StaticResource BrushWarning}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="12" Background="{StaticResource BrushSurfaceAlt}" VerticalAlignment="Center">
                        <TextBlock Text="&#x1F6E1;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="14" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="LAST SCAN" Style="{StaticResource MutedText}" FontSize="11" FontWeight="Bold" />
                        <TextBlock x:Name="LastScanText" Text="Never" FontSize="22" FontWeight="Black" Foreground="{StaticResource BrushMuted}" Margin="0,6,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="12" Background="{StaticResource BrushSurfaceAlt}" VerticalAlignment="Center">
                        <TextBlock Text="&#x23F1;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- Tabs -->
        <TabControl Grid.Row="2" Margin="28,0,28,0">
            <TabItem Header="Dashboard">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Controller scan" FontSize="22" FontWeight="Black" />
                                    <TextBlock Text="Read-only device discovery. No rumble, lightbar, or audio packets are sent." Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Scan Controllers" Width="150" Margin="0,0,10,0" Click="ScanButton_Click" />
                                    <Button Content="Export JSON" Width="120" Margin="0,0,10,0" Style="{StaticResource SecondaryButton}" Click="ExportJsonButton_Click" />
                                    <Button Content="Export Markdown" Width="155" Margin="0,0,10,0" Style="{StaticResource SecondaryButton}" Click="ExportMarkdownButton_Click" />
                                    <Button Content="Clear" Width="90" Style="{StaticResource SecondaryButton}" Click="ClearButton_Click" />
                                </StackPanel>
                            </Grid>

                            <DataGrid x:Name="ReportsGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionChanged="ReportsGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Device" Binding="{Binding Device.DisplayName}" Width="2*" />
                                    <DataGridTextColumn Header="Profile" Binding="{Binding ProfileName}" Width="180" />
                                    <DataGridTextColumn Header="Risk" Binding="{Binding RecommendedRiskLevel}" Width="90" />
                                    <DataGridTextColumn Header="VID" Binding="{Binding Device.VendorId}" Width="70" />
                                    <DataGridTextColumn Header="PID" Binding="{Binding Device.ProductId}" Width="70" />
                                    <DataGridTextColumn Header="Connection" Binding="{Binding Device.ConnectionType}" Width="110" />
                                    <DataGridTextColumn Header="Source" Binding="{Binding Device.Source}" Width="150" />
                                    <DataGridTextColumn Header="Audio" Binding="{Binding WindowsAudioEndpoint}" Width="110" />
                                    <DataGridTextColumn Header="DS4 Audio" Binding="{Binding Ds4AudioProtocol}" Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Selected Device" FontSize="21" FontWeight="Black" />
                                    <TextBlock Text="Pick a detected row to inspect its evidence." Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Copy" Width="76" Style="{StaticResource SecondaryButton}" Click="CopyDetailsButton_Click" />
                            </Grid>

                            <Border Style="{StaticResource SoftCard}" Padding="14">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="DetailsText" Text="Run a scan, then select a device." TextWrapping="Wrap" Style="{StaticResource MutedText}" />
                                </ScrollViewer>
                            </Border>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Stages">
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Staged Test Plan" FontSize="22" FontWeight="Black" />
                                <TextBlock Text="A controlled path from build verification to USB, Bluetooth, feature tests, Audio Lab, and packaging." Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Explain Selected Stage" Width="178" Style="{StaticResource SecondaryButton}" Click="ExplainSelectedStageButton_Click" />
                        </Grid>

                        <DataGrid x:Name="StagesGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=StageRows}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="130" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="190" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="135" />
                                <DataGridTextColumn Header="Goal" Binding="{Binding Goal}" Width="2*" />
                                <DataGridTextColumn Header="What to do" Binding="{Binding WhatToDo}" Width="2*" />
                                <DataGridTextColumn Header="Pass criteria" Binding="{Binding PassCriteria}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>

            <TabItem Header="Profiles">
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                            <TextBlock Text="Compatibility Profiles" FontSize="22" FontWeight="Black" />
                            <TextBlock Text="Starter records for clone and reference controllers. Unknowns stay unknown until real scan evidence proves them." Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <DataGrid AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ProfileRows}" MinHeight="260">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Profile" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="160" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="190" />
                                <DataGridTextColumn Header="Evidence needed" Binding="{Binding EvidenceNeeded}" Width="3*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>

            <TabItem Header="Feature Tests">
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Feature Test Registry" FontSize="22" FontWeight="Black" />
                                <TextBlock Text="Safe tests are enabled first. Controlled and experimental tests stay locked until their stage and safety gates are ready." Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Explain Selected Test" Width="174" Style="{StaticResource SecondaryButton}" Click="ExplainSelectedFeatureButton_Click" />
                        </Grid>

                        <DataGrid x:Name="FeatureTestsGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FeatureTestRows}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Feature" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="140" />
                                <DataGridTextColumn Header="Risk" Binding="{Binding RiskLevel}" Width="105" />
                                <DataGridTextColumn Header="Target" Binding="{Binding RequiresSelectedDevice}" Width="90" />
                                <DataGridTextColumn Header="Confirm" Binding="{Binding RequiresUserConfirmation}" Width="90" />
                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="100" />
                                <DataGridTextColumn Header="Goal" Binding="{Binding Goal}" Width="3*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>

            <TabItem Header="  Live Input  ">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Device selector bar -->
                    <Border Grid.Row="0" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Source:" Style="{StaticResource MutedText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <ComboBox x:Name="DeviceComboBox" Width="380" Margin="12,0,0,0" VerticalAlignment="Center" DisplayMemberPath="DisplayName" />
                            <Button x:Name="StartInputButton" Content="Start Live" Width="120" Margin="14,0,0,0" Click="StartInputButton_Click" />
                            <Button x:Name="StopInputButton" Content="Stop" Width="80" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="StopInputButton_Click" IsEnabled="False" />
                            <TextBlock x:Name="LiveStatusText" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="18,0,0,0" Text="Select a device and press Start." />
                        </StackPanel>
                    </Border>

                    <!-- Main content area -->
                    <Border Grid.Row="1" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Sticks -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                                <TextBlock Text="Sticks" FontWeight="Black" FontSize="15" Margin="0,0,0,12" />

                                <TextBlock Text="Left Stick" Style="{StaticResource MutedText}" FontSize="12" />
                                <Border Background="{StaticResource BrushSurfaceAlt}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="4" Margin="0,4,0,12">
                                    <StackPanel HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="LeftStickText" Style="{StaticResource AccentText}" FontSize="13" />
                                        </StackPanel>
                                        <Canvas x:Name="LeftStickCanvas" Width="160" Height="160" Margin="0,8,0,4">
                                            <Ellipse Width="160" Height="160" Fill="{StaticResource BrushSurface}" Stroke="{StaticResource BrushBorder}" StrokeThickness="1" />
                                            <Line X1="80" Y1="10" X2="80" Y2="150" Stroke="{StaticResource BrushBorder}" StrokeThickness="0.5" />
                                            <Line X1="10" Y1="80" X2="150" Y2="80" Stroke="{StaticResource BrushBorder}" StrokeThickness="0.5" />
                                            <Ellipse Width="14" Height="14" Fill="{StaticResource BrushPrimary}" Opacity="0.9" x:Name="LeftStickDot" />
                                        </Canvas>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Right Stick" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" />
                                <Border Background="{StaticResource BrushSurfaceAlt}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="4" Margin="0,4,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="RightStickText" Style="{StaticResource AccentText}" FontSize="13" />
                                        </StackPanel>
                                        <Canvas x:Name="RightStickCanvas" Width="160" Height="160" Margin="0,8,0,4">
                                            <Ellipse Width="160" Height="160" Fill="{StaticResource BrushSurface}" Stroke="{StaticResource BrushBorder}" StrokeThickness="1" />
                                            <Line X1="80" Y1="10" X2="80" Y2="150" Stroke="{StaticResource BrushBorder}" StrokeThickness="0.5" />
                                            <Line X1="10" Y1="80" X2="150" Y2="80" Stroke="{StaticResource BrushBorder}" StrokeThickness="0.5" />
                                            <Ellipse Width="14" Height="14" Fill="{StaticResource BrushPrimary}" Opacity="0.9" x:Name="RightStickDot" />
                                        </Canvas>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Center: Buttons -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                <TextBlock Text="Buttons" FontWeight="Black" FontSize="15" Margin="0,0,0,12" />

                                <!-- Shoulders -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <Button x:Name="L1Button" Content="L1" Width="70" Style="{StaticResource PadButton}" />
                                    <Button x:Name="R1Button" Content="R1" Width="70" Margin="12,0,0,0" Style="{StaticResource PadButton}" />
                                </StackPanel>

                                <!-- D-Pad + Face buttons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <Grid Width="140" Height="140">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Button x:Name="DpadUpButton" Grid.Column="1" Content="&#x25B2;" Style="{StaticResource PadButton}" />
                                        <Button x:Name="DpadLeftButton" Grid.Column="0" Grid.Row="1" Content="&#x25C0;" Style="{StaticResource PadButton}" />
                                        <Button x:Name="DpadRightButton" Grid.Column="2" Grid.Row="1" Content="&#x25B6;" Style="{StaticResource PadButton}" />
                                        <Button x:Name="DpadDownButton" Grid.Column="1" Grid.Row="2" Content="&#x25BC;" Style="{StaticResource PadButton}" />
                                    </Grid>

                                    <Grid Width="140" Height="140" Margin="24,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Button x:Name="SquareButton" Grid.Column="0" Grid.Row="0" Content="&#x25A0;" Style="{StaticResource PadButton}" />
                                        <Button x:Name="TriangleButton" Grid.Column="1" Grid.Row="0" Content="&#x25B3;" Style="{StaticResource PadButton}" />
                                        <Button x:Name="CrossButton" Grid.Column="0" Grid.Row="1" Content="&#x2715;" Style="{StaticResource PadButton}" />
                                        <Button x:Name="CircleButton" Grid.Column="1" Grid.Row="1" Content="&#x25EF;" Style="{StaticResource PadButton}" />
                                    </Grid>
                                </StackPanel>

                                <!-- Triggers -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <Button x:Name="L2Button" Content="L2" Width="70" Style="{StaticResource PadButton}" />
                                    <Button x:Name="R2Button" Content="R2" Width="70" Margin="12,0,0,0" Style="{StaticResource PadButton}" />
                                </StackPanel>

                                <!-- System buttons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,0">
                                    <Button x:Name="ShareButton" Content="Share" Width="64" Style="{StaticResource PadButton}" FontSize="11" />
                                    <Button x:Name="OptionsButton" Content="Opt" Width="54" Margin="6,0,0,0" Style="{StaticResource PadButton}" FontSize="11" />
                                    <Button x:Name="PsButton" Content="PS" Width="46" Margin="6,0,0,0" Style="{StaticResource PadButton}" />
                                    <Button x:Name="TouchpadButton" Content="Touch" Width="60" Margin="6,0,0,0" Style="{StaticResource PadButton}" FontSize="11" />
                                    <Button x:Name="L3Button" Content="L3" Width="46" Margin="6,0,0,0" Style="{StaticResource PadButton}" />
                                    <Button x:Name="R3Button" Content="R3" Width="46" Margin="6,0,0,0" Style="{StaticResource PadButton}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Right: Triggers, Motion, Battery, Raw -->
                            <StackPanel Grid.Column="4" VerticalAlignment="Top" Width="240">
                                <TextBlock Text="Triggers" FontWeight="Black" FontSize="15" Margin="0,0,0,10" />

                                <TextBlock Text="L2" Style="{StaticResource MutedText}" FontSize="12" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                    <ProgressBar x:Name="L2Bar" Minimum="0" Maximum="255" Height="10" Width="170" />
                                    <TextBlock x:Name="L2ValueText" Style="{StaticResource AccentText}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" Text="0" />
                                </StackPanel>

                                <TextBlock Text="R2" Style="{StaticResource MutedText}" FontSize="12" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,16">
                                    <ProgressBar x:Name="R2Bar" Minimum="0" Maximum="255" Height="10" Width="170" />
                                    <TextBlock x:Name="R2ValueText" Style="{StaticResource AccentText}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" Text="0" />
                                </StackPanel>

                                <TextBlock Text="Motion" FontWeight="Black" FontSize="15" Margin="0,4,0,8" />
                                <Border Background="{StaticResource BrushSurfaceAlt}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock x:Name="GyroText" Style="{StaticResource MutedText}" FontSize="12" />
                                        <TextBlock x:Name="AccelText" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Battery" FontWeight="Black" FontSize="15" Margin="0,0,0,8" />
                                <Border Background="{StaticResource BrushSurfaceAlt}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                                    <TextBlock x:Name="BatteryText" Style="{StaticResource MutedText}" FontSize="12" />
                                </Border>

                                <TextBlock Text="Raw Report" FontWeight="Black" FontSize="15" Margin="0,0,0,8" />
                                <Border Background="{StaticResource BrushSurfaceAlt}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10" MaxHeight="110">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="RawHexText" Style="{StaticResource MutedText}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Output tests -->
                    <Border Grid.Row="2" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Output Tests" FontWeight="Black" FontSize="15" Margin="0,0,0,4" />
                            <TextBlock Text="Sends DS4 output reports. Requires a live session." Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,12" />

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Rumble S" Style="{StaticResource MutedText}" VerticalAlignment="Center" FontSize="12" />
                                <Slider x:Name="RumbleSmallSlider" Minimum="0" Maximum="255" Width="140" Margin="8,0,0,0" Value="255" VerticalAlignment="Center" />
                                <TextBlock Text="Rumble L" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="12" />
                                <Slider x:Name="RumbleLargeSlider" Minimum="0" Maximum="255" Width="140" Margin="8,0,0,0" Value="0" VerticalAlignment="Center" />
                                <Button x:Name="PulseRumbleButton" Content="Pulse" Width="90" Margin="16,0,0,0" Click="PulseRumbleButton_Click" FontSize="12" />

                                <Border Width="1" Height="28" Background="{StaticResource BrushBorder}" Margin="20,0" VerticalAlignment="Center" />

                                <TextBlock Text="R" Style="{StaticResource MutedText}" VerticalAlignment="Center" FontSize="12" />
                                <Slider x:Name="LightbarRedSlider" Minimum="0" Maximum="255" Width="100" Margin="6,0,0,0" Value="0" VerticalAlignment="Center" />
                                <TextBlock Text="G" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" />
                                <Slider x:Name="LightbarGreenSlider" Minimum="0" Maximum="255" Width="100" Margin="6,0,0,0" Value="255" VerticalAlignment="Center" />
                                <TextBlock Text="B" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" />
                                <Slider x:Name="LightbarBlueSlider" Minimum="0" Maximum="255" Width="100" Margin="6,0,0,0" Value="0" VerticalAlignment="Center" />
                                <Button x:Name="SetLightbarButton" Content="Lightbar" Width="100" Margin="12,0,0,0" Click="SetLightbarButton_Click" FontSize="12" />
                                <Button x:Name="ResetOutputButton" Content="Reset" Width="70" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="ResetOutputButton_Click" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="  Virtual Controller  ">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Target:" Style="{StaticResource MutedText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <ComboBox x:Name="VirtualTargetComboBox" Width="240" Margin="10,0,0,0" VerticalAlignment="Center" SelectedIndex="0">
                                    <ComboBoxItem Content="DualShock 4 (DS4)" />
                                    <ComboBoxItem Content="Xbox 360 (XInput)" />
                                </ComboBox>

                                <TextBlock Text="Source:" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="20,0,0,0" FontWeight="SemiBold" />
                                <ComboBox x:Name="VirtualDeviceComboBox" Width="380" Margin="10,0,0,0" VerticalAlignment="Center" DisplayMemberPath="DisplayName" />
                                <Button x:Name="VirtualStartButton" Content="Start Passthrough" Width="160" Margin="14,0,0,0" Click="VirtualStartButton_Click" />
                                <Button x:Name="VirtualStopButton" Content="Stop" Width="80" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="VirtualStopButton_Click" IsEnabled="False" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <TextBlock Text="Profile:" Style="{StaticResource MutedText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBox x:Name="VirtualProfileTextBox" Width="380" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="JSON profile path" />
                                <Button x:Name="VirtualProfileApplyButton" Content="Apply" Width="80" Margin="12,0,0,0" Style="{StaticResource SecondaryButton}" Click="VirtualProfileApplyButton_Click" />
                                <Button x:Name="VirtualProfileDefaultButton" Content="Default" Width="80" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="VirtualProfileDefaultButton_Click" />
                            </StackPanel>

                            <TextBlock x:Name="VirtualProfileStatusText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0" Text="No profile applied." />
                            <TextBlock x:Name="VirtualStatusText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Game Feedback" FontWeight="Black" FontSize="15" Margin="0,0,0,6" />
                            <Border Background="{StaticResource BrushSurfaceAlt}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <TextBlock x:Name="VirtualFeedbackText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Text="No feedback received yet." />
                            </Border>
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12" Text="Requires ViGEmBus. Virtual pad mirrors physical input; game rumble, lightbar, and LED requests are forwarded back." />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="  Mouse Lab  ">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Source:" Style="{StaticResource MutedText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <ComboBox x:Name="MouseDeviceComboBox" Width="380" Margin="10,0,0,0" VerticalAlignment="Center" DisplayMemberPath="DisplayName" />
                                <Button x:Name="MouseStartButton" Content="Start Emulation" Width="150" Margin="14,0,0,0" Click="MouseStartButton_Click" />
                                <Button x:Name="MouseStopButton" Content="Stop" Width="80" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="MouseStopButton_Click" IsEnabled="False" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <CheckBox x:Name="MouseTouchCheckBox" Content="Touchpad → Mouse" IsChecked="True" VerticalAlignment="Center" />
                                <CheckBox x:Name="MouseGyroCheckBox" Content="Gyro → Mouse" IsChecked="True" Margin="16,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Text="Sensitivity:" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="20,0,0,0" FontWeight="SemiBold" />
                                <Slider x:Name="MouseSensitivitySlider" Width="180" Minimum="0.1" Maximum="10" Value="1" Margin="8,0,0,0" VerticalAlignment="Center" ValueChanged="MouseSensitivitySlider_ValueChanged" />
                                <TextBlock x:Name="MouseSensitivityText" Style="{StaticResource AccentText}" VerticalAlignment="Center" Margin="8,0,0,0" Text="1.00" FontWeight="Bold" />
                            </StackPanel>

                            <TextBlock x:Name="MouseStatusText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="How it works" FontWeight="Black" FontSize="15" Margin="0,0,0,8" />
                            <Border Background="{StaticResource BrushSurfaceAlt}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="12.5"
                                           Text="One finger moves the mouse (tap to click, drag to hold). Two fingers hold right-click. Touchpad press = left-click hold. Gyro tilts move the mouse. Sensitivity tunes both modes." />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="  Audio Lab  ">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="DS4 / DualSense Audio Lab" FontWeight="Black" FontSize="18" />
                                <Button x:Name="AudioRefreshButton" Content="Refresh" Width="90" Margin="14,0,0,0" FontSize="12" />
                                <TextBlock x:Name="AudioDeviceCountText" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0" Text="No devices." FontSize="12" />
                            </StackPanel>

                            <TextBlock Text="Stream audio between controller speaker/mic and Windows via WASAPI." Style="{StaticResource MutedText}" Margin="0,6,0,14" FontSize="12.5" TextWrapping="Wrap" />

                            <!-- Speaker -->
                            <Border Background="{StaticResource BrushSurfaceAlt}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Speaker Output" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox x:Name="AudioSpeakerComboBox" Width="380" VerticalAlignment="Center" DisplayMemberPath="Name" />
                                        <TextBlock Text="Vol:" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12" />
                                        <Slider x:Name="AudioSpeakerVolumeSlider" Width="140" Minimum="0" Maximum="100" Value="80" Margin="8,0,0,0" VerticalAlignment="Center" ValueChanged="AudioSpeakerVolumeSlider_ValueChanged" />
                                        <TextBlock x:Name="AudioSpeakerVolumeText" Style="{StaticResource AccentText}" VerticalAlignment="Center" Margin="6,0,0,0" Text="80%" FontWeight="Bold" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button x:Name="AudioPlaybackStartButton" Content="Start Playback" Width="130" FontSize="12" Click="AudioPlaybackStartButton_Click" />
                                        <Button x:Name="AudioPlaybackStopButton" Content="Stop" Width="70" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="AudioPlaybackStopButton_Click" IsEnabled="False" FontSize="12" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Microphone -->
                            <Border Background="{StaticResource BrushSurfaceAlt}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Microphone Input" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox x:Name="AudioMicComboBox" Width="380" VerticalAlignment="Center" DisplayMemberPath="Name" />
                                        <TextBlock Text="Vol:" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12" />
                                        <Slider x:Name="AudioMicVolumeSlider" Width="140" Minimum="0" Maximum="100" Value="80" Margin="8,0,0,0" VerticalAlignment="Center" ValueChanged="AudioMicVolumeSlider_ValueChanged" />
                                        <TextBlock x:Name="AudioMicVolumeText" Style="{StaticResource AccentText}" VerticalAlignment="Center" Margin="6,0,0,0" Text="80%" FontWeight="Bold" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button x:Name="AudioCaptureStartButton" Content="Start Capture" Width="130" FontSize="12" Click="AudioCaptureStartButton_Click" />
                                        <Button x:Name="AudioCaptureStopButton" Content="Stop" Width="70" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="AudioCaptureStopButton_Click" IsEnabled="False" FontSize="12" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Route -->
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="AudioRouteButton" Content="Route Mic → Speaker" Width="180" Click="AudioRouteButton_Click" />
                                <TextBlock x:Name="AudioRouteStatusText" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="14,0,0,0" Text="Not routed." />
                            </StackPanel>

                            <TextBlock x:Name="AudioStatusText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="12" Text="Click Refresh to detect controller audio endpoints." />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Stream Log" FontWeight="Black" FontSize="15" Margin="0,0,0,8" />
                            <Border Background="{StaticResource BrushSurfaceAlt}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12" MaxHeight="180">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="AudioLogText" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="12" Text="No audio activity yet." />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="3" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="28,10">
            <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap"
                       Text="PadScope v1.0 — Read-only diagnostics. Rumble and lightbar are manual confirmed tests only. Audio Lab streams via WASAPI." />
        </Border>
    </Grid>
</Window>
