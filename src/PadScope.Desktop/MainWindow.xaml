<Window x:Class="PadScope.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PadScope · Controller Diagnostics" Width="1280" Height="820"
        MinWidth="1040" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <Border Grid.Row="0" Background="{DynamicResource B_Card}" BorderBrush="{DynamicResource B_Border}"
                BorderThickness="0,0,0,1" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="44" Height="44" CornerRadius="13" Background="{DynamicResource B_PrimaryDim}"
                        BorderBrush="{DynamicResource B_Primary}" BorderThickness="1">
                    <Grid>
                        <Ellipse Width="24" Height="24" Stroke="#66FFFFFF" StrokeThickness="1" />
                        <TextBlock Text="P" FontSize="18" FontWeight="Black" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="PadScope" Style="{DynamicResource PageTitle}" />
                    <TextBlock Text="Controller intelligence · Evidence before assumptions"
                               Style="{DynamicResource Dim}" FontSize="11" Margin="0,1,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource B_PrimarySoft}" BorderBrush="{DynamicResource B_PrimaryDim}"
                            BorderThickness="1" CornerRadius="12" Padding="11,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7"
                                     Fill="{DynamicResource B_Success}" Margin="0,0,6,0" />
                            <TextBlock x:Name="StatusText" Text="Ready"
                                       Style="{DynamicResource Dim}" FontSize="11.5" />
                        </StackPanel>
                    </Border>
                    <Button Content="About" Width="74" Height="32" Margin="0,0,8,0"
                            Style="{DynamicResource Sec}" Click="AboutButton_Click" />
                    <Button x:Name="ThemeButton" Content="Light" Width="74" Height="32"
                            Style="{DynamicResource Sec}" Click="ToggleThemeButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== MAIN CONTENT ===== -->
        <Grid Grid.Row="1" Margin="18,12,18,14">
            <TabControl>
                <!-- ===== SCAN ===== -->
                <TabItem Header="  Scan  ">
                    <Grid Margin="4,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Summary cards -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{DynamicResource MetricCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="DETECTED DEVICES" Style="{DynamicResource Eyebrow}" />
                                        <TextBlock x:Name="DeviceCountText" Text="0" FontSize="28" FontWeight="Bold"
                                                   Foreground="{DynamicResource B_Primary}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="36" Height="36" CornerRadius="10" Background="{DynamicResource B_PrimarySoft}">
                                        <TextBlock Text="⌁" FontSize="20" Foreground="{DynamicResource B_Primary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Style="{DynamicResource MetricCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="PROFILE MATCHES" Style="{DynamicResource Eyebrow}" />
                                        <TextBlock x:Name="ProfileCountText" Text="0" FontSize="28" FontWeight="Bold"
                                                   Foreground="{DynamicResource B_Success}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="36" Height="36" CornerRadius="10" Background="{DynamicResource B_PrimarySoft}">
                                        <TextBlock Text="✓" FontSize="16" Foreground="{DynamicResource B_Success}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                            <Border Grid.Column="4" Style="{DynamicResource MetricCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="LAST READ-ONLY SCAN" Style="{DynamicResource Eyebrow}" />
                                        <TextBlock x:Name="LastScanText" Text="Not run" FontSize="22" FontWeight="Bold"
                                                   Foreground="{DynamicResource B_Warning}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="36" Height="36" CornerRadius="10" Background="{DynamicResource B_PrimarySoft}">
                                        <TextBlock Text="◷" FontSize="18" Foreground="{DynamicResource B_Warning}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Action row -->
                        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="ScanButton" Content="Scan controllers" Click="ScanButton_Click" ToolTip="Read-only: inspect Windows controller interfaces" />
                            <Button Content="Clear" Style="{DynamicResource Sec}" Click="ClearButton_Click" Margin="6,0,0,0" />
                            <Border Width="1" Background="{DynamicResource B_Border}" Margin="12,6" />
                            <Button Content="Export JSON" Style="{DynamicResource Sec}" Click="ExportJsonButton_Click" />
                            <Button Content="Export Markdown" Style="{DynamicResource Sec}" Click="ExportMarkdownButton_Click" Margin="6,0,0,0" />
                            <Border Width="1" Background="{DynamicResource B_Border}" Margin="12,6" />
                            <TextBlock x:Name="CurrentStageText" Text="0/1 Ready" VerticalAlignment="Center"
                                       Foreground="{DynamicResource B_Warning}" FontWeight="SemiBold" FontSize="12.5" />
                            <ProgressBar x:Name="ScanProgress" Width="86" Height="4" Margin="12,0,0,0"
                                         IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center" />
                        </WrapPanel>

                        <!-- Reports data grid -->
                        <Border Grid.Row="2" Style="{DynamicResource Card}" Margin="0,0,0,10" Padding="0" Height="190">
                            <Grid>
                            <DataGrid x:Name="ReportsGrid" AutoGenerateColumns="False" HeadersVisibility="Column"
                                      SelectionChanged="ReportsGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Device" Binding="{Binding Device.DisplayName}" Width="200" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Profile" Binding="{Binding ProfileName}" Width="180" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Input" Binding="{Binding Input}" Width="80" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Rumble" Binding="{Binding Rumble}" Width="80" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Lightbar" Binding="{Binding Lightbar}" Width="80" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Gyro" Binding="{Binding Gyro}" Width="60" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Touchpad" Binding="{Binding Touchpad}" Width="80" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Audio" Binding="{Binding WindowsAudioEndpoint}" Width="80" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel x:Name="ScanEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsHitTestVisible="False" MaxWidth="440">
                                <Border Width="48" Height="48" CornerRadius="15" Background="{DynamicResource B_PrimarySoft}"
                                        HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <TextBlock Text="⌁" FontSize="25" Foreground="{DynamicResource B_Primary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="ScanEmptyTitle" Text="Start with a safe controller scan"
                                           Style="{DynamicResource SectionTitle}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="ScanEmptySubtitle"
                                           Text="PadScope reads Windows device metadata only. It will not send rumble, lightbar, or audio output."
                                           Style="{DynamicResource Dim}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Details + Stages + Features (lower half) -->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Details + Profiles -->
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Device Details" FontWeight="SemiBold" FontSize="13"
                                               Foreground="{DynamicResource B_Text}" VerticalAlignment="Center" />
                                    <Button Content="Copy" Style="{DynamicResource Sec}" Height="28" MinWidth="60"
                                            FontSize="11" Click="CopyDetailsButton_Click" Margin="10,0,0,0" />
                                </StackPanel>

                                <Border Grid.Row="1" Style="{DynamicResource CardAlt}" Margin="0,0,0,8" Padding="0">
                                    <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="DetailsText" Text="Run a scan, then select a device."
                                                   Style="{DynamicResource Dim}" FontSize="12" TextWrapping="Wrap"
                                                   Padding="14,10" />
                                    </ScrollViewer>
                                </Border>

                                <Border Grid.Row="2" Style="{DynamicResource Card}" Padding="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="14,10,14,6">
                                            <TextBlock Text="Profile Catalog" FontWeight="SemiBold" FontSize="13"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>

                                        <DataGrid Grid.Row="1" AutoGenerateColumns="False" HeadersVisibility="Column" ItemsSource="{Binding ProfileRows}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="140" IsReadOnly="True" />
                                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120" IsReadOnly="True" />
                                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" IsReadOnly="True" />
                                                <DataGridTextColumn Header="Evidence Needed" Binding="{Binding EvidenceNeeded}" Width="240" IsReadOnly="True" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Stages + Feature Tests -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Stages -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Test Stages" FontWeight="SemiBold" FontSize="13"
                                               VerticalAlignment="Center" />
                                    <Button Content="Explain" Style="{DynamicResource Sec}" Height="28" MinWidth="60"
                                            FontSize="11" Click="ExplainSelectedStageButton_Click" Margin="10,0,0,0" />
                                </StackPanel>

                                <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="0">
                                    <DataGrid x:Name="StagesGrid" AutoGenerateColumns="False" HeadersVisibility="Column" ItemsSource="{Binding StageRows}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="50" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="140" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" IsReadOnly="True" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>

                                <!-- Feature Tests -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,6">
                                    <TextBlock Text="Feature Tests" FontWeight="SemiBold" FontSize="13"
                                               VerticalAlignment="Center" />
                                    <Button Content="Explain" Style="{DynamicResource Sec}" Height="28" MinWidth="60"
                                            FontSize="11" Click="ExplainSelectedFeatureButton_Click" Margin="10,0,0,0" />
                                </StackPanel>

                                <Border Grid.Row="3" Style="{DynamicResource Card}" Padding="0">
                                    <DataGrid x:Name="FeatureTestsGrid" AutoGenerateColumns="False" HeadersVisibility="Column" ItemsSource="{Binding FeatureTestRows}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="140" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="50" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Risk" Binding="{Binding RiskLevel}" Width="50" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Device?" Binding="{Binding RequiresSelectedDevice}" Width="55" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Confirm?" Binding="{Binding RequiresUserConfirmation}" Width="60" IsReadOnly="True" />
                                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="60" IsReadOnly="True" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ===== LIVE INPUT ===== -->
                <TabItem Header="  Live Input  ">
                    <Grid Margin="4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left panel: controls + buttons -->
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>

                            <!-- Device picker -->
                            <Border Style="{DynamicResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Device" Style="{DynamicResource Dim}" FontSize="11.5" Margin="0,0,0,6" />
                                    <ComboBox x:Name="DeviceComboBox" DisplayMemberPath="DisplayName" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Start" Click="StartInputButton_Click" x:Name="StartInputButton" />
                                        <Button Content="Stop" Style="{DynamicResource Sec}" Click="StopInputButton_Click" x:Name="StopInputButton" Margin="6,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="LiveStatusText" Text="Scan first to detect a controller."
                                       Style="{DynamicResource Dim}" FontSize="11.5" TextWrapping="Wrap"
                                       Margin="18,10,18,0" />

                            <!-- D-Pad -->
                            <Border Style="{DynamicResource CardAlt}">
                                <StackPanel>
                                    <TextBlock Text="D-Pad" Style="{DynamicResource Dim}" FontSize="11.5" Margin="0,0,0,6" />
                                    <Grid Width="110" Height="110">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="36" />
                                            <RowDefinition Height="38" />
                                            <RowDefinition Height="36" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="36" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Row="0" Grid.Column="1" x:Name="DpadUpButton" Content="U" FontSize="11" Style="{StaticResource PadBtn}" />
                                        <Button Grid.Row="2" Grid.Column="1" x:Name="DpadDownButton" Content="D" FontSize="11" Style="{StaticResource PadBtn}" />
                                        <Button Grid.Row="1" Grid.Column="0" x:Name="DpadLeftButton" Content="L" FontSize="11" Style="{StaticResource PadBtn}" />
                                        <Button Grid.Row="1" Grid.Column="2" x:Name="DpadRightButton" Content="R" FontSize="11" Style="{StaticResource PadBtn}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Face buttons -->
                            <Border Style="{DynamicResource CardAlt}" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="Face Buttons" Style="{DynamicResource Dim}" FontSize="11.5" Margin="0,0,0,6" />
                                    <Grid Width="110" Height="110">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="36" />
                                            <RowDefinition Height="38" />
                                            <RowDefinition Height="36" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="36" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Row="0" Grid.Column="1" x:Name="TriangleButton" Content="T" FontSize="11" Style="{StaticResource PadBtn}" />
                                        <Button Grid.Row="2" Grid.Column="1" x:Name="CrossButton" Content="X" FontSize="11" Style="{StaticResource PadBtn}" />
                                        <Button Grid.Row="1" Grid.Column="0" x:Name="SquareButton" Content="S" FontSize="11" Style="{StaticResource PadBtn}" />
                                        <Button Grid.Row="1" Grid.Column="2" x:Name="CircleButton" Content="O" FontSize="11" Style="{StaticResource PadBtn}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Shoulder + system buttons -->
                            <Border Style="{DynamicResource CardAlt}" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="Shoulder / System" Style="{DynamicResource Dim}" FontSize="11.5" Margin="0,0,0,6" />
                                    <WrapPanel>
                                        <Button x:Name="L1Button" Content="L1" FontSize="11" Style="{StaticResource PadBtn}" Width="40" Margin="0,0,4,4" />
                                        <Button x:Name="R1Button" Content="R1" FontSize="11" Style="{StaticResource PadBtn}" Width="40" Margin="0,0,4,4" />
                                        <Button x:Name="L2Button" Content="L2" FontSize="11" Style="{StaticResource PadBtn}" Width="40" Margin="0,0,4,4" />
                                        <Button x:Name="R2Button" Content="R2" FontSize="11" Style="{StaticResource PadBtn}" Width="40" Margin="0,0,4,4" />
                                        <Button x:Name="L3Button" Content="L3" FontSize="11" Style="{StaticResource PadBtn}" Width="40" Margin="0,0,4,4" />
                                        <Button x:Name="R3Button" Content="R3" FontSize="11" Style="{StaticResource PadBtn}" Width="40" Margin="0,0,4,4" />
                                        <Button x:Name="ShareButton" Content="SH" FontSize="11" Style="{StaticResource PadBtn}" Width="40" Margin="0,0,4,4" />
                                        <Button x:Name="OptionsButton" Content="OP" FontSize="11" Style="{StaticResource PadBtn}" Width="40" Margin="0,0,4,4" />
                                        <Button x:Name="PsButton" Content="PS" FontSize="11" Style="{StaticResource PadBtn}" Width="40" Margin="0,0,4,4" />
                                        <Button x:Name="TouchpadButton" Content="TP" FontSize="11" Style="{StaticResource PadBtn}" Width="40" Margin="0,0,4,4" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Output controls -->
                            <Border Style="{DynamicResource Card}" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="Output Tests" Style="{DynamicResource Dim}" FontSize="11.5" Margin="0,0,0,6" />
                                    <TextBlock Text="Rumble" Style="{DynamicResource Dim}" FontSize="11" Margin="0,0,0,2" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Small" Style="{DynamicResource Dim}" FontSize="10" Width="36" VerticalAlignment="Center" />
                                        <Slider x:Name="RumbleSmallSlider" Width="90" Minimum="0" Maximum="255" Value="0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Large" Style="{DynamicResource Dim}" FontSize="10" Width="36" VerticalAlignment="Center" />
                                        <Slider x:Name="RumbleLargeSlider" Width="90" Minimum="0" Maximum="255" Value="0" />
                                    </StackPanel>
                                    <TextBlock Text="Lightbar" Style="{DynamicResource Dim}" FontSize="11" Margin="0,6,0,2" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="R" Style="{DynamicResource Dim}" FontSize="10" Width="14" VerticalAlignment="Center" />
                                        <Slider x:Name="LightbarRedSlider" Width="80" Minimum="0" Maximum="255" Value="0" />
                                        <TextBlock Text="G" Style="{DynamicResource Dim}" FontSize="10" Width="14" VerticalAlignment="Center" Margin="4,0,0,0" />
                                        <Slider x:Name="LightbarGreenSlider" Width="80" Minimum="0" Maximum="255" Value="0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="B" Style="{DynamicResource Dim}" FontSize="10" Width="14" VerticalAlignment="Center" />
                                        <Slider x:Name="LightbarBlueSlider" Width="80" Minimum="0" Maximum="255" Value="0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button x:Name="PulseRumbleButton" Content="Pulse Rumble" Click="PulseRumbleButton_Click" FontSize="11" />
                                        <Button x:Name="SetLightbarButton" Content="Set Lightbar" Style="{DynamicResource Sec}" Click="SetLightbarButton_Click"
                                                FontSize="11" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <Button x:Name="ResetOutputButton" Content="Reset Output" Style="{DynamicResource Sec}" Click="ResetOutputButton_Click"
                                            FontSize="11" HorizontalAlignment="Left" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        </ScrollViewer>

                        <!-- Right panel: live state -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Sticks -->
                            <Border Grid.Row="0" Style="{DynamicResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Left Stick" Style="{DynamicResource Dim}" FontSize="11.5" Margin="0,0,0,6" />
                                        <Border Background="{DynamicResource B_CardAlt}" CornerRadius="8" Width="180" Height="180"
                                                HorizontalAlignment="Left">
                                            <Grid>
                                                <Canvas x:Name="LeftStickCanvas" Width="180" Height="180">
                                                    <Ellipse Width="180" Height="180" Fill="Transparent"
                                                             Stroke="{DynamicResource B_Border}" StrokeThickness="1" Canvas.Left="0" Canvas.Top="0" />
                                                    <Ellipse Width="10" Height="10" Fill="{DynamicResource B_Primary}"
                                                             x:Name="LeftStickDot" Canvas.Left="85" Canvas.Top="85" />
                                                </Canvas>
                                            </Grid>
                                        </Border>
                                        <TextBlock x:Name="LeftStickText" Text="X   0  Y   0" FontSize="11"
                                                   Foreground="{DynamicResource B_TextDim}" Margin="0,6,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Right Stick" Style="{DynamicResource Dim}" FontSize="11.5" Margin="0,0,0,6" />
                                        <Border Background="{DynamicResource B_CardAlt}" CornerRadius="8" Width="180" Height="180"
                                                HorizontalAlignment="Left">
                                            <Grid>
                                                <Canvas x:Name="RightStickCanvas" Width="180" Height="180">
                                                    <Ellipse Width="180" Height="180" Fill="Transparent"
                                                             Stroke="{DynamicResource B_Border}" StrokeThickness="1" Canvas.Left="0" Canvas.Top="0" />
                                                    <Ellipse Width="10" Height="10" Fill="{DynamicResource B_Primary}"
                                                             x:Name="RightStickDot" Canvas.Left="85" Canvas.Top="85" />
                                                </Canvas>
                                            </Grid>
                                        </Border>
                                        <TextBlock x:Name="RightStickText" Text="X   0  Y   0" FontSize="11"
                                                   Foreground="{DynamicResource B_TextDim}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Triggers -->
                            <Border Grid.Row="1" Style="{DynamicResource Card}" Margin="0,6,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="L2ValueText" Text="L2 0  (0%)" FontSize="11.5"
                                                   Foreground="{DynamicResource B_TextDim}" Margin="0,0,0,6" />
                                        <ProgressBar x:Name="L2Bar" Height="10" Minimum="0" Maximum="255" Value="0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock x:Name="R2ValueText" Text="R2 0  (0%)" FontSize="11.5"
                                                   Foreground="{DynamicResource B_TextDim}" Margin="0,0,0,6" />
                                        <ProgressBar x:Name="R2Bar" Height="10" Minimum="0" Maximum="255" Value="0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Motion + Battery -->
                            <Border Grid.Row="2" Style="{DynamicResource Card}" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="Motion Sensors" Style="{DynamicResource Dim}" FontSize="11.5" Margin="0,0,0,6" />
                                    <TextBlock x:Name="GyroText" Text="Gyro  X      0  Y      0  Z      0" FontSize="11.5"
                                               Foreground="{DynamicResource B_TextDim}" />
                                    <TextBlock x:Name="AccelText" Text="Accel X      0  Y      0  Z      0" FontSize="11.5"
                                               Foreground="{DynamicResource B_TextDim}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="3" Style="{DynamicResource Card}" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="Battery / Touch" Style="{DynamicResource Dim}" FontSize="11.5" Margin="0,0,0,6" />
                                    <TextBlock x:Name="BatteryText" Text="Battery level not reported" FontSize="11.5"
                                               Foreground="{DynamicResource B_TextDim}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Raw hex -->
                            <Border Grid.Row="4" Style="{DynamicResource Card}" Margin="0,6,0,0" Padding="0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="100">
                                    <StackPanel Margin="18,12">
                                        <TextBlock Text="Raw HID Report" Style="{DynamicResource Dim}" FontSize="11.5" Margin="0,0,0,6" />
                                        <TextBlock x:Name="RawHexText" Text="" FontSize="11"
                                                   Foreground="{DynamicResource B_TextDim}" TextWrapping="Wrap"
                                                   FontFamily="Consolas" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ===== VIRTUAL CONTROLLER ===== -->
                <TabItem Header="  Virtual Controller  ">
                    <Grid Margin="4,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Device + target picker -->
                        <Border Grid.Row="0" Style="{DynamicResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Source Device" Style="{DynamicResource Dim}" FontSize="11.5" Margin="0,0,0,6" />
                                    <ComboBox x:Name="VirtualDeviceComboBox" DisplayMemberPath="DisplayName" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                    <TextBlock Text="Virtual Target" Style="{DynamicResource Dim}" FontSize="11.5" Margin="0,0,0,6" />
                                    <ComboBox x:Name="VirtualTargetComboBox" Width="180" SelectedIndex="0">
                                        <ComboBoxItem Content="ViGEm DualShock 4" />
                                        <ComboBoxItem Content="ViGEm Xbox 360" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
                                    <Button Content="Start" Click="VirtualStartButton_Click" x:Name="VirtualStartButton" />
                                    <Button Content="Stop" Style="{DynamicResource Sec}" Click="VirtualStopButton_Click"
                                            x:Name="VirtualStopButton" Margin="6,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="VirtualStatusText" Text="" Style="{DynamicResource Dim}" FontSize="11.5"
                                   TextWrapping="Wrap" Margin="0,8,0,0" Grid.Row="1" />

                        <!-- Status + profile -->
                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Feedback -->
                            <Border Grid.Column="0" Style="{DynamicResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Game Feedback" Style="{DynamicResource Dim}" FontSize="11.5" Margin="0,0,0,6" />
                                    <TextBlock x:Name="VirtualFeedbackText" Text="No feedback received yet."
                                               FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Profile -->
                            <Border Grid.Column="2" Style="{DynamicResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Controller Profile" Style="{DynamicResource Dim}" FontSize="11.5" Margin="0,0,0,6" />
                                    <TextBlock x:Name="VirtualProfileStatusText" Text="No profile applied. Remapping is off."
                                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />
                                    <TextBlock Text="Profile path" Style="{DynamicResource Dim}" FontSize="11" Margin="0,0,0,4" />
                                    <TextBox x:Name="VirtualProfileTextBox" FontSize="11.5" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Apply" Click="VirtualProfileApplyButton_Click" FontSize="11" />
                                        <Button Content="Create Default" Style="{DynamicResource Sec}" Click="VirtualProfileDefaultButton_Click"
                                                FontSize="11" Margin="6,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ===== MOUSE LAB ===== -->
                <TabItem Header="  Mouse Lab  ">
                    <Grid Margin="4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Settings -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{DynamicResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Device" Style="{DynamicResource Dim}" FontSize="11.5" Margin="0,0,0,6" />
                                    <ComboBox x:Name="MouseDeviceComboBox" DisplayMemberPath="DisplayName" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Start" Click="MouseStartButton_Click" x:Name="MouseStartButton" />
                                        <Button Content="Stop" Style="{DynamicResource Sec}" Click="MouseStopButton_Click"
                                                x:Name="MouseStopButton" Margin="6,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Style="{DynamicResource Card}" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="Input Source" Style="{DynamicResource Dim}" FontSize="11.5" Margin="0,0,0,6" />
                                    <CheckBox x:Name="MouseTouchCheckBox" Content="Touchpad" />
                                    <CheckBox x:Name="MouseGyroCheckBox" Content="Gyro" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Style="{DynamicResource Card}" Margin="0,6,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Sensitivity" Style="{DynamicResource Dim}" FontSize="11.5" />
                                        <TextBlock x:Name="MouseSensitivityText" Text="1.00" FontSize="11.5"
                                                   Foreground="{DynamicResource B_Primary}" FontWeight="SemiBold" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <Slider x:Name="MouseSensitivitySlider" Minimum="0.1" Maximum="5.0" Value="1.0"
                                            ValueChanged="MouseSensitivitySlider_ValueChanged" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Status area -->
                        <Grid Grid.Column="2">
                            <Border Style="{DynamicResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Mouse Emulation" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />
                                    <TextBlock x:Name="MouseStatusText"
                                               Text="Scan first to detect a controller, then start mouse emulation."
                                               FontSize="12.5" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ===== AUDIO ===== -->
                <TabItem Header="  Audio  ">
                    <Grid Margin="4,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Device list + refresh -->
                        <Border Grid.Row="0" Style="{DynamicResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Speaker" Style="{DynamicResource Dim}" FontSize="11.5" Margin="0,0,0,6" />
                                    <ComboBox x:Name="AudioSpeakerComboBox" Width="280" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Microphone" Style="{DynamicResource Dim}" FontSize="11.5" Margin="0,0,0,6" />
                                    <ComboBox x:Name="AudioMicComboBox" Width="280" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                                    <Button Content="Refresh Devices" Click="AudioRefreshButton_Click" HorizontalAlignment="Left" />
                                    <TextBlock x:Name="AudioDeviceCountText" Text="" Style="{DynamicResource Dim}"
                                               FontSize="11" Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Playback + Capture + Route -->
                        <Border Grid.Row="1" Style="{DynamicResource Card}" Margin="0,6,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Playback" Style="{DynamicResource Dim}" FontSize="11.5" Margin="0,0,0,6" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Start" Click="AudioPlaybackStartButton_Click" x:Name="AudioPlaybackStartButton" FontSize="11" />
                                        <Button Content="Stop" Style="{DynamicResource Sec}" Click="AudioPlaybackStopButton_Click"
                                                x:Name="AudioPlaybackStopButton" Margin="6,0,0,0" FontSize="11" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Capture" Style="{DynamicResource Dim}" FontSize="11.5" Margin="0,0,0,6" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Start" Click="AudioCaptureStartButton_Click" x:Name="AudioCaptureStartButton" FontSize="11" />
                                        <Button Content="Stop" Style="{DynamicResource Sec}" Click="AudioCaptureStopButton_Click"
                                                x:Name="AudioCaptureStopButton" Margin="6,0,0,0" FontSize="11" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Route Mic to Speaker" Style="{DynamicResource Dim}" FontSize="11.5" Margin="0,0,0,6" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Start Routing" Click="AudioRouteButton_Click" HorizontalAlignment="Left" FontSize="11" />
                                        <Button Content="Stop Routing" Click="AudioRouteStopButton_Click" Style="{DynamicResource Sec}"
                                                Margin="6,0,0,0" HorizontalAlignment="Left" FontSize="11" />
                                    </StackPanel>
                                    <TextBlock x:Name="AudioRouteStatusText" Text="" Style="{DynamicResource Dim}"
                                               FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Volumes + status -->
                        <Border Grid.Row="2" Style="{DynamicResource Card}" Margin="0,6,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Speaker Volume" Style="{DynamicResource Dim}" FontSize="11.5" />
                                        <TextBlock x:Name="AudioSpeakerVolumeText" Text="50%" FontSize="11.5"
                                                   Foreground="{DynamicResource B_Primary}" FontWeight="SemiBold" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <Slider Minimum="0" Maximum="100" Value="50"
                                            ValueChanged="AudioSpeakerVolumeSlider_ValueChanged" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Mic Volume" Style="{DynamicResource Dim}" FontSize="11.5" />
                                        <TextBlock x:Name="AudioMicVolumeText" Text="50%" FontSize="11.5"
                                                   Foreground="{DynamicResource B_Primary}" FontWeight="SemiBold" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <Slider Minimum="0" Maximum="100" Value="50"
                                            ValueChanged="AudioMicVolumeSlider_ValueChanged" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Status" Style="{DynamicResource Dim}" FontSize="11.5" Margin="0,0,0,6" />
                                    <TextBlock x:Name="AudioStatusText" Text="" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Log -->
                        <Border Grid.Row="3" Style="{DynamicResource Card}" Margin="0,6,0,0" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Audio Log" Style="{DynamicResource Dim}"
                                           FontSize="11.5" Margin="18,12,18,6" />

                                <Border Grid.Row="1" Background="{DynamicResource B_CardAlt}" CornerRadius="0,0,14,14" Padding="0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="AudioLogText" Text="" FontSize="11" FontFamily="Consolas"
                                                   Foreground="{DynamicResource B_TextDim}" TextWrapping="Wrap"
                                                   Padding="18,10,18,14" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- ===== FOOTER ===== -->
        <Border Grid.Row="2" Background="{DynamicResource B_Card}" BorderBrush="{DynamicResource B_Border}"
                BorderThickness="0,1,0,0" Padding="22,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="VersionText" Text="PadScope" Style="{DynamicResource Dim}" FontSize="11" />
                <TextBlock Grid.Column="1" Text="Diagnostics first · Unknown stays unknown"
                           Style="{DynamicResource Dim}" FontSize="11" />
            </Grid>
        </Border>
    </Grid>
</Window>
