<Application x:Class="PadScope.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- Default = Dark colors -->
        <Color x:Key="C_Background">#050713</Color>
        <Color x:Key="C_BackdropMid">#0A0D22</Color>
        <Color x:Key="C_BackdropEnd">#071523</Color>
        <Color x:Key="C_Card">#B30C1021</Color>
        <Color x:Key="C_CardAlt">#99121830</Color>
        <Color x:Key="C_Border">#667583B8</Color>
        <Color x:Key="C_Primary">#22D3EE</Color>
        <Color x:Key="C_PrimaryDim">#8B5CF6</Color>
        <Color x:Key="C_Text">#F7F9FF</Color>
        <Color x:Key="C_TextDim">#8490AF</Color>
        <Color x:Key="C_Success">#34D399</Color>
        <Color x:Key="C_Warning">#FBBF24</Color>
        <Color x:Key="C_Danger">#FB7185</Color>
        <Color x:Key="C_PrimarySoft">#3324264F</Color>
        <Color x:Key="C_SurfaceHover">#CC202747</Color>

        <SolidColorBrush x:Key="B_Background" Color="{DynamicResource C_Background}" />
        <SolidColorBrush x:Key="B_Card" Color="{DynamicResource C_Card}" />
        <SolidColorBrush x:Key="B_CardAlt" Color="{DynamicResource C_CardAlt}" />
        <SolidColorBrush x:Key="B_Border" Color="{DynamicResource C_Border}" />
        <SolidColorBrush x:Key="B_Primary" Color="{DynamicResource C_Primary}" />
        <SolidColorBrush x:Key="B_PrimaryDim" Color="{DynamicResource C_PrimaryDim}" />
        <SolidColorBrush x:Key="B_Text" Color="{DynamicResource C_Text}" />
        <SolidColorBrush x:Key="B_TextDim" Color="{DynamicResource C_TextDim}" />
        <SolidColorBrush x:Key="B_Success" Color="{DynamicResource C_Success}" />
        <SolidColorBrush x:Key="B_Warning" Color="{DynamicResource C_Warning}" />
        <SolidColorBrush x:Key="B_Danger" Color="{DynamicResource C_Danger}" />
        <SolidColorBrush x:Key="B_PrimarySoft" Color="{DynamicResource C_PrimarySoft}" />
        <SolidColorBrush x:Key="B_SurfaceHover" Color="{DynamicResource C_SurfaceHover}" />
        <SolidColorBrush x:Key="B_White" Color="White" />

        <LinearGradientBrush x:Key="B_WindowBackdrop" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{DynamicResource C_Background}" Offset="0" />
            <GradientStop Color="{DynamicResource C_BackdropMid}" Offset="0.55" />
            <GradientStop Color="{DynamicResource C_BackdropEnd}" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="B_BrandGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#8B5CF6" Offset="0" />
            <GradientStop Color="#3B82F6" Offset="0.52" />
            <GradientStop Color="#22D3EE" Offset="1" />
        </LinearGradientBrush>

        <DropShadowEffect x:Key="GlassShadow" BlurRadius="28" ShadowDepth="10"
                          Direction="270" Color="#B0000000" Opacity="0.38" />

        <!-- Window -->
        <Style TargetType="Window">
            <Setter Property="Background" Value="{DynamicResource B_WindowBackdrop}" />
            <Setter Property="Foreground" Value="{DynamicResource B_Text}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <!-- TextBlock -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource B_Text}" />
        </Style>
        <Style x:Key="Dim" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource B_TextDim}" />
        </Style>
        <Style x:Key="Accent" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource B_Primary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource B_Text}" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource B_Text}" />
        </Style>
        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource B_TextDim}" />
        </Style>

        <!-- Cards -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource B_Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource B_Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Effect" Value="{StaticResource GlassShadow}" />
        </Style>
        <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="18,15" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>
        <Style x:Key="InfoBanner" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource B_PrimarySoft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource B_PrimaryDim}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="12,9" />
        </Style>
        <Style x:Key="CardAlt" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource B_CardAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource B_Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <!-- Primary button -->
        <Style TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource B_PrimaryDim}" />
            <Setter Property="BorderBrush" Value="{DynamicResource B_Primary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource B_Primary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.35" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary button -->
        <Style x:Key="Sec" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="70" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{DynamicResource B_Text}" />
            <Setter Property="Background" Value="{DynamicResource B_CardAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource B_Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource B_SurfaceHover}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource B_Primary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PadBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource B_Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource B_Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource B_CardAlt}" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="RowHeight" Value="38" />
            <Setter Property="HorizontalGridLinesBrush" Value="Transparent" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource B_Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource B_Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource B_SurfaceHover}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource B_PrimarySoft}" />
                    <Setter Property="Foreground" Value="{DynamicResource B_Text}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource B_Text}" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource B_CardAlt}" />
            <Setter Property="Foreground" Value="{DynamicResource B_TextDim}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BorderBrush" Value="{DynamicResource B_Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <!-- Tabs -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource B_TextDim}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="tb" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                    Padding="16,10" CornerRadius="18">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="active" Height="3" Background="Transparent" CornerRadius="2"
                                    VerticalAlignment="Bottom" Margin="12,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tb" Property="Background" Value="{DynamicResource B_CardAlt}" />
                                <Setter Property="Foreground" Value="{DynamicResource B_Text}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tb" Property="Background" Value="{DynamicResource B_PrimarySoft}" />
                                <Setter TargetName="tb" Property="BorderBrush" Value="{DynamicResource B_PrimaryDim}" />
                                <Setter Property="Foreground" Value="{DynamicResource B_Text}" />
                                <Setter TargetName="active" Property="Background" Value="{DynamicResource B_Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Inputs -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource B_CardAlt}" />
            <Setter Property="Foreground" Value="{DynamicResource B_Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource B_Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource B_CardAlt}" />
            <Setter Property="Foreground" Value="{DynamicResource B_Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource B_Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CaretBrush" Value="{DynamicResource B_Primary}" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{DynamicResource B_Primary}" />
            <Setter Property="Background" Value="{DynamicResource B_CardAlt}" />
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource B_Primary}" />
            <Setter Property="Background" Value="{DynamicResource B_CardAlt}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource B_Text}" />
        </Style>

    </Application.Resources>
</Application>
